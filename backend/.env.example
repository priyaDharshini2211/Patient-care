PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=patient_management
# Auto-create tables from entities (dev only). Set false and use database/schema.sql in production.
DB_SYNC=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Seeded admin user (created on first start if missing)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# Razorpay (backend only - never expose the secret to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Optional: single connection string (Neon etc.); overrides DB_* above
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
